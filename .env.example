# Config base — RAG INTELLIGENCE BSC
# Copiar a .env y ajustar:
#   Copy-Item .env.example .env     (Windows)
#   cp .env.example .env            (Linux/Mac)
#
# El runtime real lo define docker-compose.yml (DATABASE_URL/REDIS_URL/etc. de
# los contenedores); aquí solo van los ajustes que SÍ lee el compose o el código.

# ── Seguridad / login (RAG-004, RAG-006) ──
AUTH_REQUIRED=true
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
# Contraseña del usuario admin inicial. El primer arranque crea "admin" con
# esta clave si la tabla de usuarios está vacía (bootstrap). CÁMBIALA.
ADMIN_PASSWORD=cambia-esta-clave-admin

# ── OCR (cascada adaptativa, PLAN-009) ──
OCR_ENGINE=auto                        # auto | tesseract | rapidocr | paddle
OCR_LANG=spa                           # "spa" ~2x más rápido que "spa+eng"
OCR_DETECT_ROTATION=false              # true si hay escaneos girados (más lento)
OCR_AUTO_MIN_SCORE=60                  # si Tesseract < umbral → re-OCR con RapidOCR
OCR_LOW_CONF_THRESHOLD=45              # chunks por debajo → low_confidence
OCR_ROTATION_MIN_SCORE=60              # no girar si la versión girada no se lee bien
OCR_WORKERS=3                          # páginas OCR en paralelo

# ── Embeddings / rerank ──
EMBED_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RERANK_MODEL_NAME=BAAI/bge-reranker-base
RERANK_CANDIDATES=5

# ── LLM local ──
LLM_MODEL_PATH=/models/qwen2.5-1.5b-instruct-q4_k_m.gguf
LLM_MAX_TOKENS=256
LLM_N_CTX=2048
CONTEXT_MAX_CHARS=2500
PERFIL=rapido                          # rapido | calidad

# ── Motor RAG verificable (CP-006/007) ──
EVIDENCE_MIN_SOURCES=1
EVIDENCE_MIN_SCORE=0.15

# ── MinIO (opcional; el compose usa "minioadmin" por defecto) ──
# MINIO_PASSWORD=minioadmin
