# Config base — RAG INTELLIGENCE BSC (copiar a .env y ajustar)
# ── Seguridad ──
AUTH_REQUIRED=true                     # gate JWT en todos los endpoints (RAG-006)
SECRET_KEY=cambia-esta-clave-larga-en-produccion
ADMIN_PASSWORD=clave-del-primer-admin  # requerida por scripts/seed_admin.py

# ── OCR (cascada adaptativa, PLAN-009) ──
OCR_ENGINE=auto                        # auto | tesseract | rapidocr | paddle
OCR_LANG=spa                           # "spa" ~2x más rápido que "spa+eng"
OCR_DETECT_ROTATION=true               # OSD + fallback 0/180 (escaneos girados)
OCR_AUTO_MIN_SCORE=60                  # si Tesseract < umbral → re-OCR con RapidOCR (manuscrito)
OCR_LOW_CONF_THRESHOLD=45              # chunks por debajo → low_confidence
OCR_ROTATION_MIN_SCORE=60              # no girar si la versión girada no se lee bien

# ── Embeddings / rerank ──
EMBED_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2  # 384-d, ~35x más rápido en CPU; alternativa BGE-M3 (1024-d) + migrar columna
RERANK_ENABLED=true
RERANK_CANDIDATES=15

# ── LLM local ──
LLM_MODEL_PATH=/models/qwen2.5-1.5b-instruct-q4_k_m.gguf
LLM_MAX_TOKENS=256
LLM_N_CTX=2048
CONTEXT_MAX_CHARS=4000
PERFIL=rapido                          # rapido | calidad

# ── Motor RAG verificable (CP-006/007) ──
EVIDENCE_MIN_SOURCES=1
EVIDENCE_MIN_SCORE=0.15

# ── Infra ──
DATABASE_URL=postgresql+asyncpg://rag_user:cambia-clave@postgres:5432/rag_medical
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/data/uploads
